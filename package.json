{
  "name": "rynkai",
  "version": "0.3.1",
  "description": "Clean, typed wrapper around Baileys with built-in plugin system and pluggable session store — for building WhatsApp bots fast.",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "types": "dist/index.d.ts",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": ["whatsapp", "bot", "baileys", "wrapper", "plugin"],
  "license": "MIT",
  "author": "rynk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rynk433/rynkai.git"
  },
  "homepage": "https://github.com/rynk433/rynkai#readme",
  "bugs": {
    "url": "https://github.com/rynk433/rynkai/issues"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.9",
    "@hapi/boom": "^10.0.1",
    "pino": "^9.4.0"
  },
  "peerDependencies": {
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.33.0",
    "node-webpmux": "^3.1.0"
  },
  "peerDependenciesMeta": {
    "qrcode-terminal": {
      "optional": true
    },
    "sharp": {
      "optional": true
    },
    "node-webpmux": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "ts-node-dev": "^2.0.0",
    "@types/node": "^20.14.0",
    "vitest": "^2.1.0",
    "sharp": "^0.33.0",
    "node-webpmux": "^3.1.0"
  },
  "files": ["dist"]
}
